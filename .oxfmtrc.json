{
  "$schema": "https://oxc.rs/schemas/oxfmt/latest.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "main",
    "out",
    "coverage",
    "build",
    "playwright-report",
    "test-results",
    "blob-report",
    "playwright/.cache",
    ".grit",
    "pnpm-lock.yaml",
    "src/assets/licenses.json",
    "CHANGELOG.md",
    ".github/workflows",
    "*.d.ts",
    ".claude/hooks",
    ".claude/skills",
    ".claude/output-styles",
    ".claude/guides",
    ".claude/rules/agent-communication.md",
    ".claude/rules/agent-role-division.md",
    ".claude/rules/agent-work-discipline.md",
    ".claude/rules/ci-workflow.md",
    ".claude/rules/codex-pairing.md",
    ".claude/rules/conclusion-only-output.md",
    ".claude/rules/doc-placement.md",
    ".claude/rules/error-handling.md",
    ".claude/rules/evergreen-documentation.md",
    ".claude/rules/pr-self-review.md",
    ".claude/rules/pr-writing-style.md",
    ".claude/rules/robustness.md",
    ".claude/rules/subagent-model-policy.md",
    ".claude/rules/subagent-resource-limits.md",
    ".claude/rules/template-sync-boundary.md",
    ".claude/rules/worktree.md",
    ".codex",
    ".cursor",
    ".devcontainer",
    ".ziku",
    "scripts/docs-lifecycle",
    "scripts/generate-agent-adapters.ts",
    "tools/agent-fleet"
  ]
}
