{
  "$schema": "https://oxc.rs/schemas/oxfmt/latest.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "main",
    "out",
    "coverage",
    "build",
    "playwright-report",
    "test-results",
    "blob-report",
    "playwright/.cache",
    ".grit",
    "pnpm-lock.yaml",
    "src/assets/licenses.json",
    "CHANGELOG.md",
    ".github/workflows",
    "*.d.ts",
    ".claude/hooks",
    ".claude/skills",
    ".claude/output-styles",
    ".claude/guides",
    ".claude/rules/*.md",
    ".codex",
    ".cursor",
    ".devcontainer",
    ".ziku",
    "scripts/docs-lifecycle",
    "scripts/docs-lifecycle.ts",
    "scripts/generate-agent-adapters.ts",
    "tools/agent-fleet"
  ]
}
