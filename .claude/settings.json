{
  "enableWorkflows": true,
  "workflowSizeGuideline": "medium",
  "outputStyle": "workspace-default",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "30000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BASH_MAX_OUTPUT_LENGTH": "30000",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "deny": [
      "Read(./secrets/**)",
      "Write(./secrets/**)",
      "Edit(./secrets/**)",
      "Read(./*/**/.env)",
      "Read(./*/**/.env.*)",
      "Write(./*/**/.env)",
      "Write(./*/**/.env.*)",
      "Edit(./*/**/.env)",
      "Edit(./*/**/.env.*)"
    ],
    "allow": ["Bash(find:*)", "Bash(rg:*)", "Bash(grep:*)", "Bash(ls:*)"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/prompt-router.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/pre-bash-guard.ts"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/pre-bash-timing.ts"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/protect-config.ts",
            "statusMessage": "Checking if file is a protected config..."
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/track-edits.ts"
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(?:github_)?create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/require-pr-self-review-mcp.ts",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/post-bash-timing.ts"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/post-bash-guard.ts"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/track-edits.ts"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/docs-lifecycle-guard.ts",
            "statusMessage": "Checking doc placement..."
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/post-lint.ts",
            "statusMessage": "Running lint on edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/stop-verify.ts",
            "statusMessage": "Running lint + test verification before completion..."
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-or-skip-for-cursor.ts .claude/hooks/stop-pr-comments.ts",
            "statusMessage": "Checking unresolved PR review threads..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": false,
    "example-skills@anthropic-agent-skills": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
